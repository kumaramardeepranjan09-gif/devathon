// =============== SETUP =========================
void setup() {
  Serial.begin(115200);
  delay(700);

  pinMode(ENA, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(ENB, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
  stopAll();

  digitalWrite(RELAY1_PIN, RELAY_ACTIVE_LOW ? HIGH : LOW);
  digitalWrite(RELAY2_PIN, RELAY_ACTIVE_LOW ? HIGH : LOW);
  pinMode(RELAY1_PIN, OUTPUT);
  pinMode(RELAY2_PIN, OUTPUT);
  relay1(false);
  relay2(false);

  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);

  ds1.begin();
  ds2.begin();
  ds1.setWaitForConversion(false);
  ds2.setWaitForConversion(false);

  Wire.begin(MPU_SDA, MPU_SCL);
  Wire.setClock(100000);
  initMPU();

  WiFi.mode(WIFI_AP);
  WiFi.setSleep(false);

  bool apOK = WiFi.softAP(
    WIFI_NAME,
    WIFI_PASSWORD,
    1,
    false,
    4
  );

  Serial.println("\n===== ESP32 DASHBOARD =====");
  Serial.print("AP started: ");
  Serial.println(apOK ? "YES" : "NO");
  Serial.print("Wi-Fi name: ");
  Serial.println(WIFI_NAME);

  Serial.print("IP address: ");
  Serial.println(WiFi.softAPIP());

  server.on("/", HTTP_GET, []() {
    server.sendHeader("Content-Encoding", "gzip");
    server.send_P(200, "text/html; charset=utf-8", (const char*)PAGE_GZ, sizeof(PAGE_GZ));
  });

  server.on("/api", HTTP_GET, handleAPI);
  const char* headers[] = {"Origin"};
  server.collectHeaders(headers, 1);
  server.on("/cmd", HTTP_POST, handleCommand);
  server.begin();

  Serial.println("Web server started");
  Serial.println("Waiting for phone connection...");

  ds1.requestTemperatures();
  ds2.requestTemperatures();
  tempStarted = millis();
  lastTempRequest = millis();
  tempPending = true;
}

// =============== LOOP ==========================
void loop() {
  server.handleClient();

  updateTemperatures();

  unsigned long now = millis();
  if (now - lastMPU >= 100) {
    lastMPU = now;
    readMPU();
    sampleSequence++;
    evaluateSafety();
  }

  static int previousClients = -1;
  int clients = WiFi.softAPgetStationNum();

  if (clients != previousClients) {
    previousClients = clients;
    Serial.print("Connected phone/device count: ");
    Serial.println(clients);
  }
}
